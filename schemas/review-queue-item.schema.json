{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-queue-item.schema.json",
  "title": "离线复核队列项",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_id",
    "role_id",
    "geography",
    "as_of_date",
    "review_reason",
    "priority",
    "source_urls",
    "access_requirement",
    "trigger_recorded",
    "network_recheck_performed",
    "queue_status"
  ],
  "properties": {
    "schema_version": {"const": "agent-hiring-map-public/1.0"},
    "queue_id": {"type": "string"},
    "role_id": {"type": "string"},
    "geography": {"enum": ["China", "United States"]},
    "last_verified_at": {"type": ["string", "null"]},
    "as_of_date": {"type": "string", "format": "date"},
    "review_reason": {
      "enum": ["time_anomaly", "ttl_expired", "ttl_due_now", "ttl_due_within_7_days"]
    },
    "priority": {"enum": ["high", "normal"]},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "access_requirement": {"type": "string"},
    "trigger_recorded": {"const": true},
    "network_recheck_performed": {"const": false},
    "queue_status": {"const": "queued_offline"}
  }
}
