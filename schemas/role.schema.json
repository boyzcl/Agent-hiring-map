{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role.schema.json",
  "title": "Role",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role_id",
    "organization_id",
    "title",
    "official_role_url",
    "evidence_ids",
    "role_display_version",
    "display_title_zh",
    "display_title_en",
    "display_location_zh",
    "display_location_en",
    "location_data_status",
    "work_arrangement",
    "work_arrangement_basis",
    "title_authenticity_version",
    "official_title_raw",
    "title_source_language",
    "title_support_status",
    "title_provenance",
    "title_source_url",
    "title_source_granularity",
    "stable_role_locator",
    "citation_supports_title",
    "title_source_observed_at",
    "title_source_recheck_performed",
    "title_source_recheck_attempted_at",
    "title_source_observation_status",
    "title_current_eligible_after_gate",
    "title_translation_status",
    "role_recovery_status",
    "role_recovery_confidence",
    "public_confidence_tier",
    "recovery_origin",
    "eligible_for_job_list",
    "eligible_for_strict_current",
    "publication_state_version",
    "currentness_terminal",
    "currentness_next_check_at",
    "evidence_exhausted",
    "public_disposition",
    "public_disposition_reason_code",
    "public_is_current",
    "decision_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent-hiring-map-public/1.0"},
    "role_id": {"type": "string"},
    "organization_id": {"type": "string"},
    "team_id": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "source_role_descriptor": {"type": ["string", "null"]},
    "role_family": {"type": ["string", "null"]},
    "job_locations": {"type": "array", "items": {"type": "string"}},
    "remote_scope": {"type": ["string", "null"]},
    "agent_specific_quote": {"type": ["string", "null"], "maxLength": 300},
    "agent_relevance_summary": {"type": ["string", "null"], "maxLength": 500},
    "agent_relevance_evidence_type": {"type": ["string", "null"]},
    "official_role_url": {"type": ["string", "null"], "format": "uri"},
    "first_seen_at": {"type": ["string", "null"]},
    "last_seen_at": {"type": ["string", "null"]},
    "last_verified_at": {"type": ["string", "null"]},
    "currentness_status": {"type": ["string", "null"]},
    "currentness_terminal": {
      "enum": [
        "open_verified",
        "closed_verified",
        "unknown_insufficient_evidence",
        "blocked_transient",
        "disputed",
        "duplicate",
        "superseded"
      ]
    },
    "currentness_next_check_at": {"type": ["string", "null"]},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "access_requirement": {"type": ["string", "null"]},
    "evidence_grade": {"type": ["string", "null"]},
    "supersedes_role_id": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^AMC-[0-9]{4,}$"}},
    "version": {"type": "integer", "minimum": 1},
    "role_display_version": {"const": "agent-hiring-map-role-display/1.0"},
    "display_title_zh": {"type": "string", "minLength": 1, "maxLength": 300},
    "display_title_en": {"type": "string", "minLength": 1, "maxLength": 300},
    "display_location_zh": {"type": "string", "minLength": 1, "maxLength": 500},
    "display_location_en": {"type": "string", "minLength": 1, "maxLength": 500},
    "location_data_status": {
      "enum": [
        "normalized_or_descriptive",
        "official_role_title_location_reviewed",
        "company_or_context_only",
        "pending_review"
      ]
    },
    "work_arrangement": {"enum": ["onsite", "remote_or_hybrid"]},
    "work_arrangement_basis": {
      "enum": [
        "explicit_remote_or_hybrid",
        "explicit_onsite",
        "default_onsite_no_remote_signal"
      ]
    },
    "title_authenticity_version": {"const": "agent-hiring-map-title-authenticity/1.0"},
    "official_title_raw": {"type": ["string", "null"], "maxLength": 300},
    "title_source_language": {"enum": ["zh", "en", "unknown"]},
    "title_support_status": {
      "enum": [
        "verified_official_title",
        "verified_official_listing",
        "pending_title_review",
        "source_granularity_insufficient",
        "disputed"
      ]
    },
    "title_provenance": {"type": "string", "minLength": 1},
    "title_source_url": {"type": ["string", "null"], "format": "uri"},
    "title_source_granularity": {
      "enum": [
        "direct_role_detail",
        "stable_official_listing_locator",
        "general_recruiting_entry",
        "official_listing_or_slug",
        "unclassified"
      ]
    },
    "stable_role_locator": {"type": ["string", "null"]},
    "citation_supports_title": {"type": "boolean"},
    "title_source_observed_at": {"type": ["string", "null"], "format": "date"},
    "title_source_recheck_performed": {"type": "boolean"},
    "title_source_recheck_attempted_at": {"type": ["string", "null"], "format": "date"},
    "title_source_observation_status": {
      "enum": [
        "fetched",
        "fetched_success",
        "http_error",
        "temporary_error",
        "held_without_fetch",
        "not_attempted"
      ]
    },
    "title_current_eligible_after_gate": {"type": "boolean"},
    "title_translation_status": {
      "enum": [
        "verified_translation",
        "source_language_preserved",
        "not_translated",
        "deterministic_bilingual_translation_v1"
      ]
    },
    "role_recovery_status": {"enum": ["verified_job", "probable_job"]},
    "role_recovery_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "public_confidence_tier": {"enum": ["verified", "probable"]},
    "public_disposition": {
      "enum": [
        "publish_current",
        "keep_public_noncurrent_closed",
        "keep_public_noncurrent_exhausted_unresolved",
        "keep_public_noncurrent_blocked",
        "keep_public_noncurrent_disputed",
        "keep_public_noncurrent_duplicate",
        "keep_public_noncurrent_superseded",
        "keep_public_noncurrent_relevance_or_title_failed",
        "suppress_public_role"
      ]
    },
    "public_disposition_reason_code": {"type": "string", "minLength": 1},
    "public_is_current": {"type": "boolean"},
    "publication_state_version": {"const": "agent-hiring-map-existing-role-public-disposition/1.0"},
    "recovery_origin": {
      "enum": [
        "existing_role_revalidated",
        "unlinked_evidence_recovered",
        "global_deferred_evidence_recovered",
        "continuous_new_role_discovery"
      ]
    },
    "geography": {"type": "string", "minLength": 1, "maxLength": 80},
    "eligible_for_job_list": {"const": true},
    "eligible_for_strict_current": {"type": "boolean"},
    "evidence_exhausted": {"type": "boolean"}
  }
}
