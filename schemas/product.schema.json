{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product.schema.json",
  "title": "Product",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "organization_id", "name", "evidence_ids"],
  "properties": {
    "schema_version": {"const": "agent-hiring-map-public/1.0"},
    "product_id": {"type": "string"},
    "organization_id": {"type": "string"},
    "name": {"type": "string"},
    "agent_category": {"type": ["string", "null"]},
    "official_url": {"type": ["string", "null"], "format": "uri"},
    "status": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^AMC-[0-9]{4}$"}},
    "version": {"type": "integer", "minimum": 1}
  }
}
