{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relation.schema.json",
  "title": "Relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation_id", "subject_id", "predicate", "object_id", "evidence_ids"],
  "properties": {
    "schema_version": {"const": "agent-hiring-map-public/1.0"},
    "relation_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "predicate": {"type": "string"},
    "object_id": {"type": "string"},
    "status": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^AMC-[0-9]{4,}$"}},
    "version": {"type": "integer", "minimum": 1}
  }
}
